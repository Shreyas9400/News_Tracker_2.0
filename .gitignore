# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
ENV/
env/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# SQLite temporary wal/shm files
*.db-shm
